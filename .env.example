# GEMINI_API_KEY: Required for the /ask AI clone feature.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for the contact form to actually send email.
# Create a free account at https://resend.com and add a verified domain/sender.
# Without this key the contact form returns an honest error + mailto fallback.
RESEND_API_KEY="MY_RESEND_API_KEY"

# FROM_EMAIL: Verified sender shown on messages (defaults to onboarding@resend.dev)
FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# APP_URL: Base URL of the deployment (used for self-referential links).
APP_URL="https://harikrishnapokhrel.com.np/"
